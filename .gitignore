# Local worktrees, dependencies and regenerated output
.worktrees/
**/node_modules/
**/build/
**/dist/
**/__pycache__/
**/.venv/
**/venv/
*.pyc
*.log
*.tmp
*.lck
*.kicad_prl
fp-info-cache
.DS_Store
Thumbs.db
desktop.ini
Desktop.ini

# Local credentials and environment overrides
.env
.env.*
!.env.example

# Review evidence is tracked unpacked; these are reproducible duplicate archives.
/site/bingbong-source.zip
/site/bingbong-static.zip
/site/bingbong-review.zip
/site/qa/motion/*-frames/

# Never add local repository metadata or snapshot bookkeeping.
.source-status-before
