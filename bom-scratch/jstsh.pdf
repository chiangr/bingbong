container text-center p-4"><div class="row justify-content-between"><div class="me-md-auto text-center text-md-start"><span>&copy; 2026 <a target="_blank" href="">Datasheet.Directory</a>. All rights reserved.</span></div></div></div></footer><!--/ footer --><!-- scripts --><!-- Bootstrap Modal Inquiry --><div class="modal" id="inquiry" tabindex="-1" role="dialog" data-bs-backdrop="static" data-bs-keyboard="false"><div class="modal-dialog" role="document"><div class="modal-content bg-white"><div class="modal-header"><h4 class="modal-title font-weight-normal">Suppliers Inquiry</h4><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><!-- Bootstrap Modal Carousel --><div id="modalCarousel" class="carousel slide border-bottom" data-bs-ride="carousel" data-bs-interval="2500"><div class="carousel-inner"><div class="carousel-item active"><img src="https://www.datasheet.live/images/abb_m_l.png" class="img-fluid mx-auto d-block"></div><div class="carousel-item"><img src="https://www.datasheet.live/images/international_rectifier_m_l.png" class="img-fluid mx-auto d-block"></div><div class="carousel-item"><img src="https://www.datasheet.live/images/mitsubishi_electric_m_l.png" class="img-fluid mx-auto d-block"></div><div class="carousel-item"><img src="https://www.datasheet.live/images/toshiba_m_l.png" class="img-fluid mx-auto d-block"></div></div><a class="carousel-control-prev" href="#modalCarousel" role="button" data-bs-slide="prev"><span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="sr-only">Previous</span></a><a class="carousel-control-next" href="#modalCarousel" role="button" data-bs-slide="next"><span class="carousel-control-next-icon" aria-hidden="true"></span><span class="sr-only">Next</span></a></div><!--/ Bootstrap Modal Carousel --><form id="contact-form" role="form" onsubmit="return onSubmit()"><div class="modal-body"><span id="part-form-group"></span><div class="form-group"><label class="control-label" for="name">Link </label><span class="fas fa-link" aria-hidden="true"></span><span id="link"></span></div><div class="form-group"><label class="control-label" for="name">Name *</label><input type="text" name="name" class="form-control" placeholder="Enter your name" required></div><div class="form-group"><label class="control-label" for="email">Reason for Contact</label><select name="reason" class="form-control" required><option value="General Inquiry">General Inquiry</option><option value="Place Order">Place Order</option><option value="Report Issue">Report Issue</option></select></div><div class="form-group"><label class="control-label" for="email">Target Price (Option)</label><input type="text" name="price" class="form-control" placeholder="Enter your target price"></div><div class="form-group"><label class="control-label" for="email">Email Address *</label><input type="email" name="email" class="form-control" placeholder="Enter your email" required></div><div class="form-group"><label class="control-label" for="message">Message *</label><textarea name="message" class="form-control" rows="4" placeholder="Enter your message" required></textarea></div><div class="form-group"><label class="control-label" for="message">BOM / Attach Files (Option)</label><input type="hidden" name="MAX_FILE_SIZE" value="10240000"><input type="file" name="files[]" class="form-control" multiple><p class="font-italic text-muted">Maximum allowed file size is 10MB</p></div><div class="form-group"><script src="https://www.recaptcha.net/recaptcha/api.js?render=6LcWlp8UAAAAADXDyucxKesy94AMlhIZerKoJxT3"></script><script>grecaptcha.ready(function(){grecaptcha.execute("6LcWlp8UAAAAADXDyucxKesy94AMlhIZerKoJxT3",{action:"homepage"}).then(function(token){document.getElementById("g-recaptcha-response").value=token})});</script><input type="hidden" id="g-recaptcha-response" name="g-recaptcha-response" /></div><div class="d-none" id="status"></div></div><div class="modal-footer"><button type="reset" class="btn btn-secondary" name="ResetButton" onclick="onReset()">Reset</button><button type="submit" class="btn btn-secondary" name="submit">Submit</button></div></form></div></div></div><script>function onSubmit(){$("#status").removeClass("d-none").addClass("progress").html("<div class=\"progress-bar progress-bar-striped progress-bar-animated\" style=\"width: 100%\"></div>");$.ajax({url:"https://www.datasheet.live/contact",method:"POST",data:new FormData($("#contact-form")[0]),dataType:"JSON",cache:false,contentType:false,processData:false,success:function(data){if(data.status){$("#status").removeClass("progress alert alert-danger").addClass("alert alert-success");$("#status").html("<span class=\"fas fa-check-circle\" aria-hidden=\"true\"></span> "+data.message);$("#contact-form").find("input[name=name], input[name=price], input[name=email], textarea").val("")}else{$("#status").removeClass("progress alert alert-success").addClass("alert alert-danger");$("#status").html("<span class=\"fas fa-exclamation-circle\" aria-hidden=\"true\"></span> "+data.message)}}});return false}function onReset(){$("#contact-form")[0].reset();$("#status").removeClass().addClass("d-none")}</script><script>function onSet(part,link){$("#contact-form").find("input, textarea").not("#g-recaptcha-response").val("");$("#status").removeClass("progress alert alert-danger alert-success").addClass("d-none").html("");if(part){$("#part-form-group").html("<div class=\"form-group\"><label class=\"control-label\" for=\"name\">Part No. </label><span class=\"fas fa-tag\" aria-hidden=\"true\"></span><input type=\"text\" name=\"part\" class=\"form-control\" value=\""+part+"\" readonly></div>")}$("#link").html("<input type=\"text\" name=\"link\" class=\"form-control\" value=\""+link+"\" readonly>")}</script><!-- jQuery Loading --><script>$(document).ready(function(){setTimeout(function(){$(".loading-spinner").fadeOut();$(".loading-content").fadeIn()},600)});</script><!-- Chatra.io: auto open chat --><script>window.onload=function(){Chatra('openChat',true)};</script><script src="https://fastly.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="https://fastly.jsdelivr.net/npm/cookieconsent@3.1.1/build/cookieconsent.min.js"></script><script src="/resources/ProductPro.min.js"></script><script src="/resources/plugin.min.js"></script><!--/ scripts --></body></html>
