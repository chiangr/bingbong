* text=auto
*.md text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.svg text eol=lf
*.py text eol=lf
*.ps1 text eol=lf

# Preserve binary payloads exactly, including ASCII-heavy PDFs and CAD files.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff2 binary
*.mp4 binary
*.zip binary
*.xlsx binary
*.3mf binary
*.3MF binary
*.step binary
*.STEP binary
*.SLDPRT binary
*.SLDASM binary
*.sldprt binary
*.sldasm binary
