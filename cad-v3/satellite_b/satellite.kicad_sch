	(text "The metal crown is the part a finger\ntouches most. It is otherwise floating:\nR1 bleeds static away slowly, D2 clamps\na fast zap to GND, which returns to the\nmain board on tail pins 1 + 12." (exclude_from_sim no) (at 314 157 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "d0eb54b5-d776-4a40-8b65-bb55000acff4"))
	(text "Board: 22 x 10 x 0.6 mm, 2 layers. This sheet = variant B. Variant A = MT6701 (satellite/), variant B = AS5600L (satellite_b/); same tail pinout and magnet (report 4.5)." (exclude_from_sim no) (at 15 268 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "9e9de22a-6579-427d-bfae-0c165d11b4e3"))
