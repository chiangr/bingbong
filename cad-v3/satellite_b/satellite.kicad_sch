	(text "Each DRV5032DU has two outputs: OUT1 switches on a north pole, OUT2 on a south pole (3.9 mT,\n20 Hz sampling, 1.6 uA). Two of them, 90 degrees apart around the magnet, give four edges\nper turn with direction -> the first twist wakes the nRF within <= 77 degrees (report 4.11)." (exclude_from_sim no) (at 19 157 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "fc381e7b-37eb-4db7-a366-207588169a8b"))
	(text "Push-pull outputs: no pull-ups.\nThermal pad (5) to GND for\nmechanical strength.\nC2/C3: TI's >= 0.1 uF at VCC." (exclude_from_sim no) (at 120 190 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "81310cf0-27a9-4cbf-a717-90bf6feed40f"))
	(rectangle (start 210 150) (end 300 262) (stroke (width 0.254) (type dash) (color 72 72 72 1)) (fill (type none)) (uuid "e1400123-ff9f-4699-acae-a0121830855d"))
	(text "D · Press — tact switch" (exclude_from_sim no) (at 211.5 151.5 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left top)) (uuid "93ca62e1-0e5a-4259-848f-2660b0b1cb79"))
