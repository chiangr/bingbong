	(label "TACT_HI" (at 265.43 205.74 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "296837e6-9bb1-403a-bdeb-9fc8910053c4"))
	(text "Pressed by the bulkhead pip when the crown\nmoves in 0.40 mm (off-axis, report 4.12).\nTACT_SRC = VBAT through 10 k (main board).\nPressed -> TACT_HI = VBAT -> the charger\nsees a button and the nRF sees TACT_NRF." (exclude_from_sim no) (at 214 157 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "1a5e6131-462b-4861-93ee-7e935a19b3b8"))
	(text "The switch carries battery voltage\n(up to 4.35 V): rate it for >= 5 V.\nCurrent only while pressed (~3 uA)." (exclude_from_sim no) (at 214 225 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "c964aa0b-57b5-44c0-92d4-4188354e5531"))
