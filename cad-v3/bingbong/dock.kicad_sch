	(text "4 hard-gold pads on the rear lid flex, 2.54 mm pitch: GND · SWCLK · SWDIO · VBUS (report A.2).\nThe 5th flex conductor, DOCK_ID, reaches only the factory/EOL jig." (exclude_from_sim no) (at 19 27 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "46501e7b-8f25-4fbd-a755-81b6c3a5f107"))
	(text "J601 pin order = flex order. VBUS_PAD goes to the power sheet (ferrite, TVS, reverse FET).\nD601-D603 = one TPD1E05U06 per signal pad, each placed right at its pad on J601.\nUnidirectional TVS: cathode (pin 1) to the pad, anode (pin 2) to GND. 5.5 V working,\nso a 5 V key-bridge never makes it conduct; 0.5 pF so SWD edges stay clean." (exclude_from_sim no) (at 19 100 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b40c16b0-1aba-4741-a6c1-ad74cb17af18"))
	(rectangle (start 200 20) (end 405 120) (stroke (width 0.254) (type dash) (color 72 72 72 1)) (fill (type none)) (uuid "1f7718f2-6580-4385-a8eb-5c5a8819bf5d"))
	(text "B · SWCLK and DOCK_ID: 5 V-tolerant buffer (one-way signals)" (exclude_from_sim no) (at 201.5 21.5 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left top)) (uuid "2c2b832b-54e2-443d-8931-8d66958878a3"))
