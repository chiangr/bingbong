	(text "C · SWDIO: bidirectional limiter cell" (exclude_from_sim no) (at 201.5 131.5 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left top)) (uuid "b37fccf7-bf3b-4979-8d9c-0ad3d3403a59"))
