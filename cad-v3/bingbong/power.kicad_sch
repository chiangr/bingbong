	(text "VDD is both the supply and the cell-voltage sense, so it sits on VBAT (not V3):\nthe gauge keeps tracking with the buck off. CELL is not connected inside the\nMAX17048; it is tied to VBAT as in the typical circuit.\nCTG and QSTRT -> GND per the datasheet. ~ALRT = low-charge alert to the nRF.\nGood % accuracy needs ADI's custom battery model (firmware, not hardware)." (exclude_from_sim no) (at 164 212 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2351c932-8ba0-4912-9082-ac4b80a86027"))
	(rectangle (start 300 135) (end 405 255) (stroke (width 0.254) (type dash) (color 72 72 72 1)) (fill (type none)) (uuid "3dfd2c11-5b62-420d-8c4c-609b69d6a397"))
	(text "F · VSYS reservoir for LTE bursts" (exclude_from_sim no) (at 301.5 136.5 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left top)) (uuid "ec4ed4ff-c8bf-40d4-872f-d0dda4fd048c"))
