	(text "PWR_FLAGs mark where VBAT (cell) and GND enter the design,\nso KiCad's ERC knows these nets are really powered." (exclude_from_sim no) (at 304 242 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "14878efe-c597-49b5-a654-59a586624d8b"))
	(text "2 x 22 uF 0805 in the side strips, next to the\nnRF9151 VDD pins. They supply the modem's ~395 mA\nTX bursts so VSYS does not dip toward the\n3.45 V cutoff (report 5.5, C-19)." (exclude_from_sim no) (at 304 212 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b8d13f80-5ade-4724-b763-eb06ed058bc5"))
	(text "Interfaces   in: VBUS_PAD (dock), TACT_HI (satellite)    out: BQ_INT, GAUGE_ALRT, TACT_NRF    bus: SDA, SCL (pull-ups on nrf9151 sheet)\nRails made here: VSYS 3.45-4.43 V · VBAT (cell) · V3 3.1 V · VBUS_IN (local)    Refs 1xx    [U] = part class chosen, MPN not final" (exclude_from_sim no) (at 15 262 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "aef6015f-d756-47fc-bcff-050c1e803afd"))
	(embedded_fonts no)
)
