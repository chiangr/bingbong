	(text "Drives the linear resonant actuator (the 'other person' feel: boop, purr, taps) with\nclosed-loop braking. OUT+/OUT- are a differential pair to the LRA at X = 52-60." (exclude_from_sim no) (at 154 27 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "90c9a9aa-dfee-41b7-b1f5-9ef6074871cf"))
