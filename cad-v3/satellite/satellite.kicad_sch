	(text "The metal crown is the part a finger\ntouches most. It is otherwise floating:\nR1 bleeds static away slowly, D2 clamps\na fast zap to GND, which returns to the\nmain board on tail pins 1 + 12." (exclude_from_sim no) (at 314 157 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "28720ed6-be3d-4af4-af44-0b5734b7b5a3"))
	(text "Board: 22 x 10 x 0.6 mm, 2 layers. This sheet = variant A. Variant A = MT6701 (satellite/), variant B = AS5600L (satellite_b/); same tail pinout and magnet (report 4.5)." (exclude_from_sim no) (at 15 268 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "98d1e947-83a8-4df9-84c0-b06b01469d6c"))
