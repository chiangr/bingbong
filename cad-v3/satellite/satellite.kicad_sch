	(text "Pressed by the bulkhead pip when the crown\nmoves in 0.40 mm (off-axis, report 4.12).\nTACT_SRC = VBAT through 10 k (main board).\nPressed -> TACT_HI = VBAT -> the charger\nsees a button and the nRF sees TACT_NRF." (exclude_from_sim no) (at 214 157 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "b0c8778f-7e7e-4477-ae92-4b909700a7d7"))
	(text "The switch carries battery voltage\n(up to 4.35 V): rate it for >= 5 V.\nCurrent only while pressed (~3 uA)." (exclude_from_sim no) (at 214 225 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "a60eccb6-ea0b-43ff-93f4-6255ba2d3589"))
